# HybridRAG local configuration.
# Copy this file to .env and adjust the values:
#
#   cp .env.example .env
#
# .env is gitignored: keep real secrets there, never in this template.

# --- PostgreSQL (docker-compose reads the same variables) ---
RAG_DB_HOST=localhost
RAG_DB_PORT=5432
RAG_DB_USER=rag_user
RAG_DB_PASSWORD=rag_password
RAG_DB_NAME=rag_db
